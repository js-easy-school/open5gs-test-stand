# Reproducible UERANSIM build for the simulated gNB and UE.
FROM ubuntu:22.04 AS build

ARG UERANSIM_VERSION=v3.3.0
ARG UERANSIM_COMMIT=6bf5a1a96aaef6ae8778b9d8b477ac6e2bbf8156
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates cmake g++ gcc git libsctp-dev make \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch "${UERANSIM_VERSION}" https://github.com/aligungr/UERANSIM.git . \
 && test "$(git rev-parse HEAD)" = "${UERANSIM_COMMIT}" \
 && make -j"$(nproc)"

FROM ubuntu:22.04

ARG UERANSIM_VERSION=v3.3.0
LABEL org.opencontainers.image.source="https://github.com/aligungr/UERANSIM" \
      org.opencontainers.image.version="${UERANSIM_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive \
    LD_LIBRARY_PATH=/usr/local/lib

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates iperf3 iproute2 iputils-ping libsctp1 lksctp-tools \
      netcat-openbsd procps \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/build/nr-gnb /usr/local/bin/nr-gnb
COPY --from=build /src/build/nr-ue  /usr/local/bin/nr-ue
COPY --from=build /src/build/nr-cli /usr/local/bin/nr-cli
COPY --from=build /src/build/libdevbnd.so /usr/local/lib/libdevbnd.so

WORKDIR /ueransim
RUN mkdir -p /ueransim/config

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["nr-gnb", "-c", "/ueransim/config/gnb.yaml"]
