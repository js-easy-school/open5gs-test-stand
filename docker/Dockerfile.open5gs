# Свой образ 5G-ядра Open5GS: один образ на все сетевые функции,
# конкретная NF выбирается командой в docker-compose.
#
# Собран многоступенчато не ради моды, а чтобы в финальном образе не остались
# apt-кеши и ключи репозитория — это стандартное требование к образам в CI.

FROM ubuntu:22.04 AS base

ARG OPEN5GS_VERSION=2.7.2
ENV DEBIAN_FRONTEND=noninteractive

# software-properties-common нужен только для add-apt-repository, дальше он не требуется
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates gnupg curl software-properties-common \
 && add-apt-repository -y ppa:open5gs/latest \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      open5gs \
      iproute2 iptables iputils-ping netcat-openbsd \
 && apt-get purge -y software-properties-common gnupg \
 && apt-get autoremove -y \
 && rm -rf /var/lib/apt/lists/*

# пакет поднимает все NF как службы systemd — в контейнере они не нужны:
# один контейнер = один процесс, запускаемый напрямую
RUN rm -rf /lib/systemd/system/open5gs-* /etc/systemd/system/multi-user.target.wants/open5gs-* || true

WORKDIR /open5gs

# конфиги монтируются томом из ./config, здесь только каталог по умолчанию
RUN mkdir -p /open5gs/config /open5gs/logs

# entrypoint ждёт зависимость (NRF или MongoDB) и только потом стартует NF —
# иначе половина функций падает на старте из-за гонки контейнеров
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["open5gs-nrfd", "-c", "/open5gs/config/nrf.yaml"]
