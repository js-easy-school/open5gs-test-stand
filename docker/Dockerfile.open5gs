# Reproducible Open5GS build. The tag and the commit are both checked so a
# moved tag cannot silently change the image used by the lab.
FROM ubuntu:22.04 AS build

ARG OPEN5GS_VERSION=v2.8.0
ARG OPEN5GS_COMMIT=157f611a530e292e40ec50f9d23f0ef5d4fcd6a6
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential bison ca-certificates cmake flex git meson ninja-build \
      pkg-config python3-pip python3-setuptools python3-wheel \
      libbson-dev libcurl4-gnutls-dev libgcrypt-dev libgnutls28-dev \
      libidn-dev libmicrohttpd-dev libmongoc-dev libnghttp2-dev \
      libsctp-dev libssl-dev libtalloc-dev libtins-dev libyaml-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src/open5gs
RUN git clone --depth 1 --branch "${OPEN5GS_VERSION}" https://github.com/open5gs/open5gs.git . \
 && test "$(git rev-parse HEAD)" = "${OPEN5GS_COMMIT}" \
 && meson setup build --prefix=/opt/open5gs --libdir=lib --buildtype=release \
 && ninja -C build \
 && ninja -C build install

FROM ubuntu:22.04

ARG OPEN5GS_VERSION=v2.8.0
LABEL org.opencontainers.image.source="https://github.com/open5gs/open5gs" \
      org.opencontainers.image.version="${OPEN5GS_VERSION}"

ENV DEBIAN_FRONTEND=noninteractive \
    LD_LIBRARY_PATH=/opt/open5gs/lib \
    PATH=/opt/open5gs/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl iproute2 iptables iputils-ping netcat-openbsd procps \
      libbson-1.0-0 libcurl3-gnutls libgcrypt20 libgnutls30 libidn12 \
      libmicrohttpd12 libmongoc-1.0-0 libnghttp2-14 libsctp1 libssl3 \
      libtalloc2 libtins4.0 libyaml-0-2 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/open5gs /opt/open5gs

WORKDIR /open5gs
RUN mkdir -p /open5gs/config /open5gs/logs

COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["open5gs-nrfd", "-c", "/open5gs/config/nrf.yaml"]
