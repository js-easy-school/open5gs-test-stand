# Скопируйте в .env и правьте под себя: docker compose подхватит автоматически.

# Готовые образы вместо своей сборки (если сборка недоступна):
# IMAGE_OPEN5GS=gradiant/open5gs:2.7.2
# IMAGE_UERANSIM=gradiant/ueransim:3.2.6

# Лимиты памяти — рассчитаны на машину с 8 ГБ
NF_MEM_LIMIT=160m
MONGO_MEM_LIMIT=512m
RAN_MEM_LIMIT=128m
